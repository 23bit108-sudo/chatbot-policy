# LLM Provider Configuration
# Choose one provider supported by rag.py: groq | openai | ollama
LLM_PROVIDER=groq

# Groq (Free, ultra-fast cloud LLM inference - recommended for Streamlit Cloud deployment)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# OpenAI (Alternative cloud provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini


# Ollama (Local development only - not used in cloud deployment)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
